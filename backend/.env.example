OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=VibeTrader Strategy Builder
PORT=5000
E2B_API_KEY=
MOEX_API_KEY=
MARKET_DATA_PROVIDER=auto

CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium

# Generated strategy engine: python or rust.
STRATEGY_ENGINE=python
# Optional for the interactive Rust worker. Historical Rust backtests link the
# strategy in-process and transfer prepared market data once via MessagePack.
STRATEGY_IPC_TRANSPORT=
STRATEGY_RUST_TARGET_DIR=
STRATEGY_RUST_BUILD_TIMEOUT_S=300

SUPABASE_JWT_SECRET=
SUPABASE_URL=
